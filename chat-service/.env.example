# Copy to .env (cp .env.example .env). .env is gitignored.

# --- Read by compose.yaml (Docker Postgres) ---
POSTGRES_DB=chat_service
POSTGRES_PASSWORD=postgres

# --- Only for `npm run dev` on your machine ---
# (in Docker, compose.yaml sets these itself)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/chat_service
PORT=3005
USER_SERVICE_PUBLIC_KEY_PATH=../user-service/keys/public.pem
ORDER_SERVICE_URL=http://localhost:3003
# Optional: only needed to run several chat instances, which share chat rooms
# through Redis (set on EKS). Leave unset for one instance.
# REDIS_URL=redis://localhost:6379