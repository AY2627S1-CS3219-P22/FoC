# Local development values only. Copy this file to .env; both docker compose and
# `npm run dev` read it. Never put production credentials here.

# --- Database ---
# Compose creates credit-db with PGUSER/PGPASSWORD/PGDATABASE and publishes it on
# PGPORT. `npm run dev` on your machine connects through PGHOST:PGPORT.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=credit_service
PGPASSWORD=credit_service_local
PGDATABASE=credit_service

# --- Auth ---
CREDIT_ORDER_SERVICE_TOKEN=local_order_credit_token
# Relative to credit-service/. Compose mounts this file into the container.
CREDIT_JWT_PUBLIC_KEY_PATH=../user-service/keys/public.pem

# --- RabbitMQ ---
# Running on your machine:
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# From inside the container (compose): the broker published on the Docker host.
DOCKER_RABBITMQ_URL=amqp://guest:guest@host.docker.internal:5672

# --- Ports ---
HTTP_PORT=3004
GRPC_PORT=50054
