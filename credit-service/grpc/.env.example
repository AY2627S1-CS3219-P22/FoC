DATABASE_URL=postgresql://credit:credit@127.0.0.1:54333/credit
GRPC_HOST=127.0.0.1
# Generate local User/Order credentials: npm run security:setup --workspace @foc/credit-grpc
# Each service receives only its own distinct credential (minimum 32 characters).
# CREDIT_USER_SERVICE_TOKEN=...
# CREDIT_ORDER_SERVICE_TOKEN=...
# CREDIT_FRONTEND_SERVICE_TOKEN=...
# CREDIT_ADMIN_SERVICE_TOKEN=...
# Frontend/admin reads also require a User Service RS256 JWT in authorization metadata.
# CREDIT_USER_JWT_PUBLIC_KEY_PATH=../../user-service/keys/public.pem
# Set these only when User Service issues matching issuer/audience claims.
# CREDIT_USER_JWT_ISSUER=...
# CREDIT_USER_JWT_AUDIENCE=...
# TLS is mandatory for production or non-loopback listeners.
# CREDIT_TLS_CERT_PATH=../keys/server-cert.pem
# CREDIT_TLS_KEY_PATH=../keys/server-key.pem
NODE_ENV=development
GRPC_PORT=50053
GRPC_TIMEOUT_MS=3000
USER_GRPC_ADDR=localhost:50052
ORDER_GRPC_ADDR=localhost:50051
CREDIT_GRPC_ADDR=localhost:50053
SUPPLIER_GRPC_ADDR=localhost:50054
