# AI Assistance Disclosure: Claude Code (Claude Opus 5.5), 2026-11-12.
# Scope: template listing chat-service's secret keys, copied from supplier-secrets.yaml.example.
# Details: ai/usage-log.md, entry 007.
# Template only. Do not apply. Create the real Secret with:
#   kubectl -n foc create secret generic chat-secrets \
#     --from-literal=DATABASE_URL='postgresql://USER:PASS@chat-db:5432/chat_service' \
#     --from-literal=PGUSER=... --from-literal=PGPASSWORD=...
# USER and PASS in DATABASE_URL must match PGUSER and PGPASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: chat-secrets
  namespace: foc
type: Opaque
stringData:
  DATABASE_URL: postgresql://<user>:<pass>@chat-db:5432/chat_service
  PGUSER: <db-user>
  PGPASSWORD: <db-password>
