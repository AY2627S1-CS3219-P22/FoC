# Template only. Do not apply. Create the real Secret with:
#   kubectl -n foc create secret generic credit-secrets \
#     --from-literal=PGUSER=... --from-literal=PGPASSWORD=... \
#     --from-literal=CREDIT_ORDER_SERVICE_TOKEN=... \
#     --from-literal=RABBITMQ_URL='amqp://USER:PASS@rabbitmq:5672?connection_timeout=10000'
apiVersion: v1
kind: Secret
metadata:
  name: credit-secrets
  namespace: foc
type: Opaque
stringData:
  PGUSER: <db-user>
  PGPASSWORD: <db-password>
  CREDIT_ORDER_SERVICE_TOKEN: <same value as order-service's secret>
  RABBITMQ_URL: amqp://<user>:<pass>@rabbitmq:5672?connection_timeout=10000
