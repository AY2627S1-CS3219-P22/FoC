# Template only. Do not apply. Create the real Secret with:
#   kubectl -n foc create secret generic order-secrets \
#     --from-literal=DATABASE_URL='postgresql://USER:PASS@order-db:5432/order_service' \
#     --from-literal=PGUSER=... --from-literal=PGPASSWORD=...\
#     --from-literal=CREDIT_ORDER_SERVICE_TOKEN=... \
#     --from-literal=RABBITMQ_URL='amqp://USER:PASS@rabbitmq:5672?connection_timeout=10000'
apiVersion: v1
kind: Secret
metadata:
  name: order-secrets
  namespace: foc
type: Opaque
stringData:
  DATABASE_URL:postgresql://<user>:<pass>@order-db:5432/order_service
  PGUSER: <db-user>
  PGPASSWORD: <db-password>
  CREDIT_ORDER_SERVICE_TOKEN: <same value as credit-service's secret>
  RABBITMQ_URL: amqp://<user>:<pass>@rabbitmq:5672?connection_timeout=10000
