# Template only. Do not apply. Create the real Secret with:
#   kubectl -n foc create secret generic user-secrets \
#     --from-literal=DATABASE_URL='postgresql://USER:PASS@user-db:5432/user_service' \
#     --from-literal=PGUSER=... --from-literal=PGPASSWORD=...\
#     --from-literal=RABBITMQ_URL='amqp://USER:PASS@rabbitmq:5672?connection_timeout=10000'
apiVersion: v1
kind: Secret
metadata:
  name: user-secrets
  namespace: foc
type: Opaque
stringData:
  DATABASE_URL: postgresql://<user>:<pass>@user-db:5432/user_service
  PGUSER: <db-user>
  PGPASSWORD: <db-password>
  RABBITMQ_URL: amqp://<user>:<pass>@rabbitmq:5672?connection_timeout=10000
