# Read by docker compose only (fills the ${...} values in compose.yaml).
# Copy to .env. For running the app on your machine, use grpc/.env instead.
# Local-only values; never put production credentials here.

# --- Local Docker Postgres (order-db) ---
POSTGRES_USER=order_service
POSTGRES_PASSWORD=order_service
POSTGRES_DB=order_service

# Must match CREDIT_ORDER_SERVICE_TOKEN in credit-service's .env.
CREDIT_ORDER_SERVICE_TOKEN=local_order_credit_token
