# Run from order-service/. The database belongs exclusively to Order Service.
DATABASE_URL=postgresql://order_service:order_service@localhost:5433/order_service?schema=public
PORT=3002
AUTH_PROVIDER=local
# Use the PUBLIC key from User Service, never its private signing key.
USER_SERVICE_PUBLIC_KEY_PATH=../user-service/keys/public.pem
# Optional: leave unset until User Service issues these claims.
# JWT_ISSUER=
# JWT_AUDIENCE=

# Optional Docker Compose host settings (container settings are in compose.yaml).
# ORDER_HTTP_PORT=3002
# ORDER_DATABASE_PORT=5433
# ORDER_PUBLIC_KEY_PATH=../user-service/keys/public.pem

# Optional Credit integration (also compatible with feat/credit-implementation).
# CREDIT_GRPC_ADDR=127.0.0.1:50054
# CREDIT_ORDER_SERVICE_TOKEN=
# TLS only: obtain the trusted CA/certificate from the Credit operator.
# Leave unset for local loopback plaintext testing.
# CREDIT_GRPC_CA_PATH=/absolute/path/to/trusted-credit-ca.pem
CREDIT_RPC_TIMEOUT_MS=3000

# On feat/credit-implementation, plaintext also requires CREDIT_LOCAL_MODE=true
# on the Credit server. This setting does not configure that server.
# User accounts need user.created allocation before Order can reserve credits.
