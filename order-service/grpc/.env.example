NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://order_service:order_service@127.0.0.1:5433/order_service
GRPC_HOST=0.0.0.0
GRPC_PORT=50053
GRPC_TIMEOUT_MS=3000
USER_GRPC_ADDR=localhost:50051
ORDER_GRPC_ADDR=localhost:50053
CREDIT_GRPC_ADDR=localhost:50054
SUPPLIER_GRPC_ADDR=localhost:50052

# AI-assisted lifecycle configuration (2026-10-22); see ../usage-log.md.
# Set the verification PUBLIC key path to enable authenticated Order writes.
# USER_SERVICE_PUBLIC_KEY_PATH=../../user-service/keys/public.pem
# Match the credential configured by Credit Service. No credential means writes
# requiring Credit return 503 and no recovery worker is started.
# CREDIT_ORDER_SERVICE_TOKEN=replace-with-your-shared-order-credential
# Set a trusted CA path when Credit uses TLS; leave unset only for the team's
# explicit local plaintext Credit setup.
# CREDIT_GRPC_CA_PATH=/absolute/path/to/credit-ca.pem
