{
  "name": "@foc/order-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copyPrismaClient.cjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "tsx --test tests/auth.test.ts tests/api.test.ts tests/domain.test.ts tests/creditGateway.test.ts",
    "test:integration": "prisma generate && tsx --test --test-concurrency=1 tests/persistence.integration.test.ts tests/commands.integration.test.ts",
    "test:typecheck": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5",
    "@foc/grpc": "0.1.0",
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
