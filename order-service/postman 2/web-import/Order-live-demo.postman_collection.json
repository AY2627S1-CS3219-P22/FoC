  "item": [
    {
      "name": "01 Accounts",
      "item": [
        {
          "name": "01 Register A",
          "request": {
            "method": "POST",
            "url": "{{userBaseUrl}}/users/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"Demo\", \"lastName\": \"A\", \"username\": \"A-{{runId}}\", \"email\": \"a-{{runId}}@u.nus.edu\", \"password\": \"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('runId')) pm.environment.set('runId', pm.variables.replaceIn('{{$guid}}'));",
                  "if (!pm.environment.get('expiryTime')) pm.environment.set('expiryTime',new Date(Date.now()+2*3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.environment.set('AId',pm.response.json().user.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Login A",
