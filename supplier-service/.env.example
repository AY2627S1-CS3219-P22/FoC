# AI Assistance Disclosure: Claude Opus (Cursor), 2026-11-05.
# Prompt: improve index.ts to ensure supplier/order pub-sub works for the supplier cache.
# Scope: documented RABBITMQ_URL under Messaging.
# Author review: Done by @sunpterodactyl, just added in rabbitmq comment.

# --- Local Docker Postgres (read by compose.yaml) ---
# Local-only values, never put production Supabase credentials
# in this file.
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres

# --- Running on your machine (npm run dev / npm start) ---
# To run the app outside Docker, copy this into .env without the leading #.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
USER_SERVICE_PUBLIC_KEY_PATH=./keys/public.pem

# --- Messaging ---
# Publishes supplier.updated / supplier.deleted to the supplier.events exchange.
# Leave unset to disable publishing.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- gRPC ---
GRPC_PORT=50052
GRPC_TIMEOUT_MS=3000
USER_GRPC_ADDR=localhost:50051
ORDER_GRPC_ADDR=localhost:50053
CREDIT_GRPC_ADDR=localhost:50054
