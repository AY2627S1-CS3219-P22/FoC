{
  "name": "Supplier-Service",
  "version": "1.0.0",
  "description": "Supplier Service for Supplier Listings and Search",
  "main": "NA",
  "author": "@sunpterodactyl, @",
  "scripts": {
    "keys:generate": "mkdir -p keys && openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem",
    "test": "vitest run tests/api",
    "test:perf": "vitest run tests/autocannon.test.ts",
    "dev": "tsx watch src/index.ts",
    "predev:grpc": "npm run build --prefix ../shared/grpc",
    "dev:grpc": "tsx watch grpc/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:grpc": "tsc -p grpc/tsconfig.json",
    "start": "node dist/index.js",
    "start:grpc": "tsx grpc/src/index.ts"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@foc/grpc": "link:../shared/grpc",
    "@grpc/grpc-js": "^1.14.5",
    "@supabase/supabase-js": "^2.117.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "4"
  }
}
