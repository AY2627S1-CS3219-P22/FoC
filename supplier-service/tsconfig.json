{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["es2018"],
    "strict": true,
    "sourceMap": false, 
    "module": "commonjs",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true, 
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true, 
    "forceConsistentCasingInFileNames": true, 
    "paths": {
      "@/*": ["./src/*"], "@models/*": ["src/data/*"]
     },
    }

}