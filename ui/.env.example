# Vite development proxy targets (server-side only). Run the supplier on 3002.
USER_SERVICE_URL=http://localhost:3001
SUPPLIER_SERVICE_URL=http://localhost:3002
# Public API prefixes; production hosting must reverse-proxy these to the services.
VITE_USER_API_BASE_URL=/api/users
VITE_SUPPLIER_API_BASE_URL=/api/suppliers
