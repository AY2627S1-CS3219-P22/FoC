# AI-assisted (Claude), reviewed and tested by Maliha
# Serves the built UI and forwards /backend/* to each service, same as the
# Vite dev proxy. Only this container is exposed to the browser.

server {
  listen 80;
  root /usr/share/nginx/html;

  # Service addresses are looked up per request (not at startup), so the UI
  # still starts if a service is down and recovers once it comes back
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_connect_timeout 5s;

  location = /health {
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  location /backend/users {
    set $users ${USER_SERVICE_URL};
    rewrite ^/backend(/.*)$ $1 break;
    proxy_pass $users;
    # refresh cookie is set on Path=/users, so the browser would never send it back otherwise
    proxy_cookie_path /users /backend/users;
  }

  # covers /backend/suppliers and /backend/supplier/:id
  location /backend/supplier {
    set $suppliers ${SUPPLIER_SERVICE_URL};
    rewrite ^/backend(/.*)$ $1 break;
    proxy_pass $suppliers;
  }

  location /backend/orders {
    set $orders ${ORDER_SERVICE_URL};
    rewrite ^/backend(/.*)$ $1 break;
    proxy_pass $orders;
  }

  location /backend/credits {
    set $credits ${CREDIT_SERVICE_URL};
    rewrite ^/backend(/.*)$ $1 break;
    proxy_pass $credits;
  }

  # build output has hashed names, so it can be cached for good
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}