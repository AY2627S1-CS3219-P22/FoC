# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- Database ---
# Local Docker Postgres (compose only; local-only values)
POSTGRES_USER=user_service
POSTGRES_PASSWORD=user_service
POSTGRES_DB=user_service
# For `npm run dev` on your Mac; reaches the user-db container via its published port.
DATABASE_URL="postgresql://user_service:user_service@localhost:5432/user_service?schema=public"

# --- Servers ---
# REST (Express).
PORT=3001
# gRPC (internal profile lookup).
GRPC_PORT=50051

# --- JWT ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# --- Refresh Token ---
NODE_ENV=development
REFRESH_TOKEN_TTL_DAYS=7

# --- Outbox / RabbitMQ ---
# Dispatcher publishes user.created after sign-up commits. Sign-up itself never
# talks to the broker; a missing broker must not fail POST /users/register.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# --- Redis (OTP cache) ---
REDIS_URL=redis://localhost:6379
# 32-byte key. Generate with: npm run keys:otp
OTP_HMAC_KEY_PATH=./keys/otp.key
