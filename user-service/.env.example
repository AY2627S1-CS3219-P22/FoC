# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- Database ---
# Matches the postgres service in compose.yaml.
DATABASE_URL="postgresql://user_service:user_service@localhost:5432/user_service?schema=public"

# --- Servers ---
# REST (Express).
PORT=3001
# gRPC (internal profile lookup).
GRPC_PORT=50051

# --- JWT ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# --- Refresh Token ---
NODE_ENV=development
REFRESH_TOKEN_TTL_DAYS=7

# --- Outbox / RabbitMQ ---
# Dispatcher publishes user.created after sign-up commits. Sign-up itself never
# talks to the broker; a missing broker must not fail POST /users/register.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
