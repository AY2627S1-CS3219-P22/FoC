# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- Database ---
# Matches the postgres service in compose.yaml.
DATABASE_URL="postgresql://user_service:user_service@localhost:5432/user_service?schema=public"

# --- Servers ---
# REST (Express).
PORT=3001
# gRPC (internal profile lookup).
GRPC_PORT=50051

# --- JWT ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# --- Redis (OTP cache) ---
REDIS_URL=redis://localhost:6379
# 32-byte key. Generate with: npm run keys:otp
OTP_HMAC_KEY_PATH=./keys/otp.key
# At least 32 characters. Shared by every instance; used to hash OTPs.
OTP_HASH_SECRET=replace-with-a-random-string-at-least-32-chars
# Path is relative to the directory you start the service from.
REDIS_OTP_LUA=./src/scripts/atomic.lua

# Mailpit. Inside Docker Compose this is the service name, not localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
