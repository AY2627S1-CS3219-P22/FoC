# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- Database ---
# Matches the postgres service in compose.yaml.
DATABASE_URL="postgresql://user_service:user_service@localhost:5432/user_service?schema=public"

# --- Servers ---
# REST (Express).
PORT=3001
# gRPC (internal profile lookup).
GRPC_PORT=50052
