    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.6.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
