# Mailpit settings for local testing. Loaded by the mailpit service in compose.yaml.

# Allow SMTP auth over plaintext. Local testing only.
MP_SMTP_AUTH_ALLOW_INSECURE=1
# Accept any username and password.
MP_SMTP_AUTH_ACCEPT_ANY=1
# SQLite database inside the mounted ./mailpit-data volume.
MP_DATABASE=/data
# Maximum number of messages to store.
MP_MAX_MESSAGES=5000
# Enable debug logging. Leave MP_LOG_FILE unset so logs stay on container stdout.
MP_VERBOSE=true
